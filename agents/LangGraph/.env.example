# Copy to .env for optional LLM polish on interpret/respond nodes.
# verify_graph.py and --demo work without keys (heuristic interpret + template respond).

# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# GIS_MCP_URL=http://127.0.0.1:9010/mcp
# GIS_MCP_CLIENT_TRANSPORT=streamable_http
# NO_PROXY=127.0.0.1,localhost
# GIS_AGENT_MODEL=deepseek/deepseek-chat-v3.1
# SKIP_LLM_INTERPRET=1
# SKIP_LLM_RESPOND=1
