# Copy to .env and fill in one LLM provider key (never commit .env).

# Option A — OpenRouter (default model in my_gis_agent.py when this is set)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option B — OpenAI (used when OPENROUTER_API_KEY is unset)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional overrides
# GIS_MCP_URL=http://127.0.0.1:9010/mcp
# GIS_MCP_CLIENT_TRANSPORT=streamable_http
# Prefer 127.0.0.1 over localhost if a corporate proxy breaks local MCP calls.
# NO_PROXY=127.0.0.1,localhost
# GIS_AGENT_MODEL=deepseek/deepseek-chat-v3.1
# GIS_AGENT_TEMPERATURE=0.2
